<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder.AppleTV.Storyboard" version="3.0" toolsVersion="24500" targetRuntime="AppleTV" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="brand-controller">
    <device id="appleTV" orientation="landscape" appearance="dark"/>
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="24500"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <scene sceneID="brand-scene">
            <objects>
                <viewController id="brand-controller" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="brand-view">
                        <rect key="frame" x="0.0" y="0.0" width="1920" height="1080"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView userInteractionEnabled="NO" contentMode="scaleAspectFit" image="KurtzLaunchWordmark" translatesAutoresizingMaskIntoConstraints="NO" id="brand-wordmark">
                                <rect key="frame" x="760" y="476" width="400" height="128"/>
                                <constraints>
                                    <constraint firstAttribute="width" constant="400" id="brand-width"/>
                                    <constraint firstAttribute="height" constant="128" id="brand-height"/>
                                </constraints>
                            </imageView>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="brand-safe-area"/>
                        <color key="backgroundColor" red="0.1215686275" green="0.1215686275" blue="0.1215686275" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                        <constraints>
                            <constraint firstItem="brand-wordmark" firstAttribute="centerX" secondItem="brand-view" secondAttribute="centerX" id="brand-center-x"/>
                            <constraint firstItem="brand-wordmark" firstAttribute="centerY" secondItem="brand-view" secondAttribute="centerY" id="brand-center-y"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="brand-responder" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
        </scene>
    </scenes>
    <resources>
        <image name="KurtzLaunchWordmark" width="1600" height="512"/>
    </resources>
</document>
